{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arete Chat",
  "version": "0.0.0",
  "identifier": "com.arete.chat",
  "build": {
    "beforeDevCommand": "pnpm --filter arete-chat dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm --filter arete-chat build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
