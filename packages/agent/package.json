{
  "name": "@arete-ui/agent",
  "version": "0.0.1",
  "private": true,
  "description": "Node agent runtime for arete-ui: a stateless AG-UI agent loop (Vercel AI SDK) with MCP tools and SKILL.md skills. Consumed by app servers; future standalone arete-agent swaps in over AG-UI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.54",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.0",
    "ollama-ai-provider-v2": "^3.5.1",
    "zod": "^4.0.16"
  },
  "peerDependencies": {
    "@arete-ui/core": "workspace:*",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@arete-ui/core": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
