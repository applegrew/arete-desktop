{
  "name": "@arete-ui/agui",
  "version": "0.0.1",
  "private": true,
  "description": "AG-UI (Agent-User Interaction) event decoder for arete-ui — maps an AG-UI event stream to arete emissions + text/tool/state callbacks, which the consumer routes through the Diff Engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.54"
  },
  "peerDependencies": {
    "@arete-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@arete-ui/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
